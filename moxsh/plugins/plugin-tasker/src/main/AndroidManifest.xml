<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Tasker 联动接收器（重写 Termux:Tasker，docs/plugins-rewrite.md §五）：
          接收 com.moxsh.plugin.tasker.RUN 意图，解析命令经 CompatShim 路由执行，
          结果以 PendingIntent 或广播回传 Tasker。
        -->
        <!--
          命令执行接收器（重写 Termux:Tasker）：执行任意命令，属高危组件。
          android:permission=signature 级权限在系统侧强制——仅同签名 App（含本应用自身）
          可投递此广播，第三方 App（含外部 Tasker）无法直接触发命令执行。
          若需外部 Tasker 联动，应改为同签名桥接组件，而非放开此接收器。

          权限名用 moxsh 自有的 com.moxsh.permission.RUN_COMMAND（由 plugin-api 声明）：
          绝不能声明/引用 com.termux.permission.RUN_COMMAND —— 与已安装的 Termux
          同名权限定义冲突会导致整包安装失败（INSTALL_FAILED_DUPLICATE_PERMISSION）。
        -->
        <receiver
            android:name=".TaskerReceiver"
            android:exported="true"
            android:permission="com.moxsh.permission.RUN_COMMAND">
            <intent-filter>
                <action android:name="com.moxsh.plugin.tasker.RUN" />
            </intent-filter>
        </receiver>

        <!-- Tasker 命令模板的玻璃配置面板（内部 UI，不对外暴露） -->
        <activity
            android:name=".TaskerGlassActivity"
            android:exported="false"
            android:theme="@style/Theme.Moxsh.Glass" />
    </application>
</manifest>
