<?xml version="1.0" encoding="utf-8"?>
<!--
  玻璃卡片布局（RemoteViews 专用：仅支持 RemoteViews 允许的 View 子集）：
  标题（点击打开主 app）+ 4 个命令按钮槽位 + 结果徽标行。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/glass_widget_bg"
    android:padding="10dp">

    <TextView
        android:id="@+id/glass_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="moxsh 玻璃卡片"
        android:textColor="#E6FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/glass_widget_btn_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/glass_widget_btn"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:text="未绑定"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <Space android:layout_width="6dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/glass_widget_btn_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/glass_widget_btn"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:text="未绑定"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <Space android:layout_width="6dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/glass_widget_btn_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/glass_widget_btn"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:text="未绑定"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <Space android:layout_width="6dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/glass_widget_btn_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/glass_widget_btn"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:text="未绑定"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/glass_widget_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
