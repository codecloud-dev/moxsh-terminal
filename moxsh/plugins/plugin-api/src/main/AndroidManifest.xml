<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- wake-lock 的本地等价实现需要 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      RUN_COMMAND 自定义权限（D7 体系①）——**必须用自己的权限名**。

      历史坑：曾直接声明 android:name="com.termux.permission.RUN_COMMAND"。
      Android 的权限定义是「全局唯一、按名字认主」的：Termux 官方已声明同名权限
      （protectionLevel=dangerous），moxsh 再用同名 permission 声明一次，两个 App
      签名又必然不同 → 安装直接被 PackageManager 拒绝
      （INSTALL_FAILED_DUPLICATE_PERMISSION）。用户实测「与 termux 权限冲突无法安装」
      即此因。**绝不能再声明他包的权限名。**

      安全语义不变：signature 级，只有与 moxsh 同证书的 App 能持有并调用
      TermuxCompatHost；第三方（含 Termux:Tasker 等）签名不同，本就无权 —— 改名前
      后的实际可调用者集合完全一致，因此改名不损失任何既有能力。
      Intent 契约（com.termux.app.RUN_COMMAND action 与 extra 名）不受影响：
      action 是自由字符串，不受权限名约束。
    -->
    <permission
        android:name="com.moxsh.permission.RUN_COMMAND"
        android:label="moxsh RUN_COMMAND 权限"
        android:description="@string/compat_run_command_permission_desc"
        android:protectionLevel="signature" />

    <application>
        <!--
          Termux 兼容宿主服务：接收新旧两种 RUN_COMMAND action，
          经 CompatShim 分类路由（Tool 本地 / Api·Shell 走加固 IPC）。
          挂上兼容权限，对齐 termux-app 的调用方校验语义。
        -->
        <service
            android:name=".TermuxCompatHost"
            android:exported="true"
            android:permission="com.moxsh.permission.RUN_COMMAND">
            <intent-filter>
                <action android:name="com.termux.app.RUN_COMMAND" />
                <action android:name="com.termux.RUN_COMMAND" />
            </intent-filter>
        </service>
    </application>
</manifest>
