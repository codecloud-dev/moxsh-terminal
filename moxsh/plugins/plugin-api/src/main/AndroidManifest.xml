<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- wake-lock 的本地等价实现需要 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      兼容 Termux 的 RUN_COMMAND 自定义权限（D7 体系①）：
      moxsh 是该权限的 owner。原本 protectionLevel=dangerous 意味着任意 app 只要
      声明 <uses-permission> 即可调用导出的 TermuxCompatHost 服务、执行真实 shell
      命令——这是高危暴露。改为 signature 后，只有与 moxsh 同签名（同证书）的 app
      才能持有该权限，对齐 Termux 官方实现，契约（action 名）仍然兼容。
    -->
    <permission
        android:name="com.termux.permission.RUN_COMMAND"
        android:label="moxsh 兼容 Termux 的 RUN_COMMAND 权限"
        android:description="@string/compat_run_command_permission_desc"
        android:protectionLevel="signature" />

    <application>
        <!--
          Termux 兼容宿主服务：接收新旧两种 RUN_COMMAND action，
          经 CompatShim 分类路由（Tool 本地 / Api·Shell 走加固 IPC）。
          挂上兼容权限，对齐 termux-app 的调用方校验语义。
        -->
        <service
            android:name=".TermuxCompatHost"
            android:exported="true"
            android:permission="com.termux.permission.RUN_COMMAND">
            <intent-filter>
                <action android:name="com.termux.app.RUN_COMMAND" />
                <action android:name="com.termux.RUN_COMMAND" />
            </intent-filter>
        </service>
    </application>
</manifest>
