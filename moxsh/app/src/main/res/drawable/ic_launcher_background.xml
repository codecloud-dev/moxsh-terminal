<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标（Adaptive Icon）背景层。
  注意：VectorDrawable 不支持 SVG 的 <defs>/<linearGradient android:id> 引用写法，
  也不支持 <rect android:rx>（那是 ShapeDrawable 的属性）；width/height 必须带单位。
  渐变需写在 <path> 内的 <aapt:attr name="android:fillColor"> + <gradient> 中。
  外形圆角由系统按厂商遮罩裁剪，背景层无需自带圆角，整幅填充即可。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#5eead4"
                android:endColor="#818cf8" />
        </aapt:attr>
    </path>
</vector>
