<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- MoX 统一标志前景层：M 粗圆头笔画 + 白色块光标。
         几何由 assets/mox-logo.svg（viewBox 64）等比放大 1.6875 倍到 108，
         与官网 favicon / 仓库 logo.svg / 社交图完全同源。 -->
    <group
        android:fillColor="#00000000"
        android:strokeColor="#0b0d12"
        android:strokeWidth="10.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <!-- M：终端窗口的字母化身 -->
        <path android:pathData="M25.3 75.9 L25.3 38.8 L48.9 61.6 L72.6 38.8 L72.6 75.9" />
    </group>
    <!-- 块光标：贴在 M 右侧的实心白块——终端 blinking cursor，亦是 X 的交叉意象 -->
    <path android:pathData="M73.4 56.5 h10.1 v18.6 h-10.1 z" android:fillColor="#ffffff" />
</vector>
