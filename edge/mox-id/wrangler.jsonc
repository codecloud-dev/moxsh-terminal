{
  "name": "mox-id-email",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-05",
  // 说明：本 Worker 不发 SMTP（CF 封锁 25 端口），改用 Resend HTTPS API，
  // 因此无需 nodejs_compat / TCP sockets。
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mox-id",
      // database_id 改为环境变量引用，避免明文写死在公开仓库；
      // 本地放 edge/mox-id/.dev.vars，CI 通过仓库 Variable D1_DATABASE_ID 注入（见 deploy-edge.yml）。
      "database_id": "{{D1_DATABASE_ID}}",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "MAIL_FROM": "mox@REPLACE_WITH_YOUR_DOMAIN"
  }
}
