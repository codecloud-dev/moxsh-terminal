{
  "name": "mox-id-email",
  "version": "1.0.0",
  "private": true,
  "description": "moxsh 邮箱验证码服务（路径 B）。默认路径为 App 端 GitHub 已验证邮箱一键绑定，无需本服务。",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "db:init:local": "wrangler d1 execute mox-id --local --file=./migrations/0001_init.sql",
    "db:init:remote": "wrangler d1 execute mox-id --remote --file=./migrations/0001_init.sql",
    "logs": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
